-            pools += lamp.power * (-dx * dx).exp();
-        }
-        // Brightest at the top, near the lamps, fading down the board.
-        let down = (-(y / 0.95) * (y / 0.95)).exp();
-        let pool = pools * down;
-        ((look.ambient + look.lamp * pool).min(1.0), look.glow * pool)
-    }
