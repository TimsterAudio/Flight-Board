-    #[test]
-    fn steps_go_forward_and_wrap() {
-        assert_eq!(Drum::Digit.steps("3", "4"), ["4"]);
-        assert_eq!(Drum::Digit.steps("9", "0"), ["0"]);
-        assert_eq!(Drum::Tens6.steps("5", "0"), ["0"]);
-        assert_eq!(Drum::Alpha.steps("B", "E"), ["C", "D", "E"]);
-        assert!(Drum::Digit.steps("7", "7").is_empty());
-    }
