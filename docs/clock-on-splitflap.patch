-    /// How lit a point is, at `x` across and `y` down the board, both from 0
-    /// to 1: the ambient light and the lamps' pools.
-    fn light(&self, look: &MoodLook, x: f32, y: f32) -> (f32, f32) {
-        let n = self.lamps.len().max(1) as f32;
